# Allowed browser origins, comma separated.
CORS_ORIGIN=https://vidsnatch.fun,https://www.vidsnatch.fun,http://localhost:5173

# Optional custom yt-dlp executable path.
# YTDLP_PATH=

# Keep YouTube cookies out of source control. Set this only in a local ignored .env
# or in your backend hosting provider's secret/environment settings.
# YOUTUBE_COOKIES=

MAX_ACTIVE_JOBS=2
